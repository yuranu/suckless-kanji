{
  "name": "suckless-kanji",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch": "scripts/fetch.sh",
    "build": "node scripts/build-curriculum.mjs && node scripts/build.mjs",
    "all": "npm run fetch && npm run build",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:matcher": "node scripts/test-matcher.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply suckless-kanji --remote && wrangler deploy",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "kuromoji": "0.1.2",
    "wrangler": "4.147.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
